vendor/
*.sql
# ...except the structure-only schema (no data) people need to run the project.
!schema/cropguard_schema.sql
/database/

# Farmer/technician photo uploads. On Railway these live on the attached
# Volume mounted at /app/uploads, so they never need to be in git - anything
# here is just local test data. Files committed before this rule stay tracked;
# this only stops new ones being picked up by a broad `git add`.
uploads/evidence/
uploads/reports/

# Local-only API keys for XAMPP. Railway reads these from its own Variables
# tab instead. Listed here BEFORE the file was created, so a real key can
# never reach a commit - Semaphore bans accounts whose key turns up in a repo.
api/config/local_secrets.php